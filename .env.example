# Copy to .env and fill in. .env is git-ignored — never commit a real key.

# Which provider to use: gemini | deepseek | qwen | xah
LLM_PROVIDER=gemini

# The paper's runs use gemini-2.5-flash, closed-book, at temperature 0.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternatives
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_MODEL=
XAH_API_KEY=
XAH_MODEL=

# Request settings
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=120
LLM_SEED=4242
